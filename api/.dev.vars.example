# Copy to .dev.vars for local development (read by both `pnpm dev:api` and `pnpm dev:node`).
# These override the production values in wrangler.toml:
ENVIRONMENT=dev
SITE_URL=http://localhost:5173
API_URL=http://localhost:5173/api

# Only needed to test real Discord sign-in; otherwise the site's dev login works without these.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
