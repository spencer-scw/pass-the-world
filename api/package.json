{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ../site/dist && wrangler dev",
    "dev:node": "ENVIRONMENT=dev tsx watch src/node/server.ts",
    "build:node": "esbuild src/node/server.ts --bundle --platform=node --target=node22 --format=esm --external:node:sqlite --outfile=dist/server.mjs",
    "deploy": "pnpm --filter site build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply pass-the-world --local",
    "db:migrate:remote": "wrangler d1 migrations apply pass-the-world --remote",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "codegen": "tsx scripts/codegen.ts",
    "codegen:check": "tsx scripts/codegen.ts --check"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.20",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
