Configs: {
	PtwConfig: {
		DisplayName: Pass the World

		ApiBaseUrl: {
			Label: Server address
			Tooltip:
				'''
				The Pass the World server to use: the website's address followed by /api.
				Leave this as it is unless your group runs its own server.
				'''
		}

		CheckpointMinutes: {
			Label: Minutes between checkpoints
			Tooltip:
				'''
				How often your progress is uploaded during a turn.
				If the game crashes or you quit, your turn resumes from the last checkpoint.
				'''
		}
	}
}
